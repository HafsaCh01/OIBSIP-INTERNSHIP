PORT=5000
MONGO_URI=mongodb://localhost:27017/pizza-delivery
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email (Nodemailer - e.g. Gmail SMTP or Mailtrap for dev)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_pass
EMAIL_FROM=noreply@pizzadelivery.com

# Frontend URL (for verification/reset links)
CLIENT_URL=http://localhost:3000

# Razorpay Test Mode
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Inventory threshold alert
INVENTORY_THRESHOLD=20
ADMIN_ALERT_EMAIL=admin@pizzadelivery.com
